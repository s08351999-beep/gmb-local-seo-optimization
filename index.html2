<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GMB Optimization | Local SEO Project</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial, sans-serif;
  background:#f4f7fb;
  color:#172033;
  line-height:1.6;
}

header{
  background:#1d4ed8;
  color:white;
  padding:18px 6%;
  position:sticky;
  top:0;
  z-index:10;
}

nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:22px;
  font-weight:bold;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:18px;
  font-size:14px;
}

.hero{
  background:linear-gradient(135deg,#172554,#2563eb);
  color:white;
  padding:90px 6%;
  text-align:center;
}

.hero h1{
  font-size:48px;
  margin-bottom:20px;
}

.hero p{
  max-width:750px;
  margin:auto;
  font-size:18px;
}

.button{
  display:inline-block;
  margin-top:28px;
  background:white;
  color:#1d4ed8;
  padding:13px 25px;
  border-radius:8px;
  text-decoration:none;
  font-weight:bold;
}

section{
  padding:65px 6%;
}

.container{
  max-width:1100px;
  margin:auto;
}

.title{
  text-align:center;
  margin-bottom:40px;
}

.title h2{
  font-size:34px;
  margin-bottom:10px;
}

.title p{
  color:#64748b;
}

.overview{
  background:white;
  padding:35px;
  border-radius:16px;
  box-shadow:0 8px 25px #00000012;
}

.cards{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.card{
  background:white;
  padding:25px;
  border-radius:15px;
  box-shadow:0 7px 22px #00000010;
}

.card h3{
  color:#1d4ed8;
  margin-bottom:10px;
}

.card p{
  color:#64748b;
}

.dark{
  background:#0f172a;
  color:white;
}

.dark .title p{
  color:#cbd5e1;
}

.dark .card{
  background:#1e293b;
}

.analysis{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

.box{
  background:white;
  padding:28px;
  border-radius:15px;
  box-shadow:0 7px 22px #00000010;
}

.box h3{
  color:#1d4ed8;
  margin-bottom:15px;
}

.box li{
  margin:9px 0;
}

table{
  width:100%;
  border-collapse:collapse;
  background:white;
  color:#172033;
  border-radius:12px;
  overflow:hidden;
}

th,td{
  padding:15px;
  border-bottom:1px solid #ddd;
  text-align:left;
}

th{
  background:#2563eb;
  color:white;
}

.strategy{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

.step{
  background:white;
  padding:25px;
  border-left:5px solid #2563eb;
  border-radius:10px;
  color:#172033;
}

.step span{
  color:#2563eb;
  font-weight:bold;
}

.recommendations{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

footer{
  background:#020617;
  color:#cbd5e1;
  text-align:center;
  padding:35px;
}

@media(max-width:800px){
  .cards,
  .recommendations{
    grid-template-columns:1fr;
  }

  .analysis,
  .strategy{
    grid-template-columns:1fr;
  }

  nav{
    flex-direction:column;
    gap:12px;
  }

  nav a{
    margin:5px;
  }

  .hero h1{
    font-size:36px;
  }
}
</style>
</head>

<body>

<header>
<nav>
<div class="logo">GMB Local SEO</div>

<div>
<a href="#overview">Overview</a>
<a href="#analysis">Analysis</a>
<a href="#keywords">Keywords</a>
<a href="#strategy">
